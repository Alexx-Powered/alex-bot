[Unit]
Description=Cache the next morning's overnight ECMWF forecast from Visual Crossing
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=alexbot
Group=alexbot
WorkingDirectory=/var/lib/alexbot
Environment=QQ_BRIDGE_HOME=/var/lib/alexbot QQ_PYTHON=/opt/alex-bot-runtime/python/app-venv/bin/python TZ=Asia/Shanghai
ExecStart=/usr/local/bin/node /opt/alex-bot/current/codex-qq-plugin/scripts/cache-morning-ecmwf.mjs
TimeoutStartSec=25s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/alexbot/.private
LimitCORE=0
MemoryMax=128M
MemorySwapMax=0
CPUQuota=50%
