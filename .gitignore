# Credentials, browser sessions and live delivery state stay on this machine.
**/.private/
**/.private-profile/
**/.qq-delivery/
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key

# Local runtimes, editors, caches and build artifacts.
**/node_modules/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.idea/
**/.vscode/
**/.npm-cache/
**/.pip-cache/
**/*.log
**/test-output/
**/output/
*.zip
!/codex-qq-plugin/data/weather-map.zip
!/codex-qq-plugin/data/weather-region-masks.zip
**/.ifs-runtime/
**/python/weather-video/
/backups/
/.agents/


# Only the public project overview and its source assets belong at the root.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/codex-qq-plugin/
!/scripts/
!/docs/
!/.github/

# Internal documentation, release receipts and engineering notes stay local.
*.md
*.html
*.pdf
*.docx
*.pptx
*.xlsx
!/README.md
!/docs/public-assets.md
!/codex-qq-plugin/THIRD_PARTY_NOTICES.md
!/codex-qq-plugin/config/chat-policy.md
!/codex-qq-plugin/codex-package/skills/qq-notify/SKILL.md
!/codex-qq-plugin/public/index.html
!/codex-qq-plugin/public/guide.html
!/codex-qq-plugin/public/social.html
!/codex-qq-plugin/public/provider-status/README.md
!/codex-qq-plugin/public/weather-report/README.md
/codex-qq-plugin/docs/
/codex-qq-plugin/deploy/
/codex-qq-plugin/local/
/docs/*
!/docs/public-assets.md
!/docs/images/
/docs/images/*
!/docs/images/*.webp
!/docs/images/*.gif
